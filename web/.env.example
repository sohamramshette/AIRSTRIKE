# AIRSTRIKE Web Client - Supabase Environment Configuration
# Copy this file to .env or .env.local and populate with your project credentials

# In local mode, game runs on port 3000 and reverse-proxies to local Supabase on port 3002
VITE_SUPABASE_URL=http://localhost:3000
VITE_SUPABASE_LOCAL_TARGET=http://localhost:3002
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here


